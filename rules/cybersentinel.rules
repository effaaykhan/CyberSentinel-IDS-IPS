# CyberSentinel-IPS — default ruleset.
#
# CyberSentinel authors its own detection content; no third-party ruleset is
# bundled or required. Format:
#
#   action proto src-addr src-port direction dst-addr dst-port (options)
#
# Blank lines and `#` comments are ignored, and a trailing `\` continues a rule
# onto the next line.
#
# SID convention (guide §3.1):
#   100000-999999      network rules
#   1000000 and above  host rules
#
# STATUS IN THIS BUILD: Phase 0 parses rule headers and metadata only. Every
# rule below uses match conditions (`content`, `flow`, sticky buffers) that the
# engine cannot evaluate until Phase 3, so on startup they load, are reported as
# "awaiting engine support", and DO NOT FIRE. That is deliberate — a rule is
# never evaluated with its conditions ignored, because that would widen the
# signature instead of narrowing it.

# ---------------------------------------------------------------------------
# Network rules — HTTP (Phase 3)
# ---------------------------------------------------------------------------

alert http $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS ( \
    msg:"CYBERSENTINEL WEB directory traversal sequence in URI"; \
    flow:established,to_server; http.uri; content:"../"; nocase; \
    classtype:web-application-attack; \
    metadata:phase 3, confidence high, tactic discovery; \
    sid:100001; rev:1;)

alert http $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS ( \
    msg:"CYBERSENTINEL WEB null byte in URI"; \
    flow:established,to_server; http.uri; content:"%00"; nocase; \
    classtype:web-application-attack; \
    metadata:phase 3, confidence medium, tactic evasion; \
    sid:100002; rev:1;)

alert http $EXTERNAL_NET any -> $HTTP_SERVERS $HTTP_PORTS ( \
    msg:"CYBERSENTINEL WEB command injection characters in URI"; \
    flow:established,to_server; http.uri; content:";"; \
    pcre:"/[;|`]\s*(cat|wget|curl|nc|bash|sh)\b/i"; \
    classtype:web-application-attack; \
    metadata:phase 3, confidence medium, tactic execution; \
    sid:100003; rev:1;)

alert http $HOME_NET any -> $EXTERNAL_NET any ( \
    msg:"CYBERSENTINEL POLICY known scanner user agent outbound"; \
    flow:established,to_server; http.user_agent; content:"sqlmap"; nocase; \
    classtype:attempted-recon; \
    metadata:phase 3, confidence high, tactic discovery; \
    sid:100010; rev:1;)

# ---------------------------------------------------------------------------
# Network rules — transport layer (Phase 3)
# ---------------------------------------------------------------------------

alert tcp $EXTERNAL_NET any -> $HOME_NET $SSH_PORTS ( \
    msg:"CYBERSENTINEL SCAN excessive SSH connection attempts"; \
    flow:to_server; \
    threshold:type threshold, track by_src, count 20, seconds 60; \
    classtype:attempted-recon; \
    metadata:phase 3, confidence medium, tactic credential-access; \
    sid:100020; rev:1;)

alert udp $HOME_NET any -> $EXTERNAL_NET $DNS_PORTS ( \
    msg:"CYBERSENTINEL DNS oversized query, possible tunnelling"; \
    dsize:>200; \
    classtype:policy-violation; \
    metadata:phase 8, confidence low, tactic exfiltration; \
    sid:100030; rev:1;)

# ---------------------------------------------------------------------------
# Host rules — SID 1000000 and above (Phase 4)
# ---------------------------------------------------------------------------

alert ip any any -> any any ( \
    msg:"CYBERSENTINEL FIM change to a system binary directory"; \
    file.path:"/usr/bin,/usr/sbin,/bin,/sbin"; file.change:"modified,created"; \
    classtype:policy-violation; \
    metadata:phase 4, confidence medium, tactic persistence; \
    sid:1000001; rev:1;)

alert ip any any -> any any ( \
    msg:"CYBERSENTINEL FIM change to an authentication configuration file"; \
    file.path:"/etc/passwd,/etc/shadow,/etc/sudoers"; \
    file.change:"modified,attributes_changed"; \
    classtype:policy-violation; \
    metadata:phase 4, confidence high, tactic persistence; \
    sid:1000002; rev:1;)

alert ip any any -> any any ( \
    msg:"CYBERSENTINEL AUTH repeated authentication failures for one account"; \
    auth.outcome:"failure"; \
    threshold:type threshold, track by_src, count 10, seconds 120; \
    classtype:attempted-admin; \
    metadata:phase 4, confidence high, tactic credential-access; \
    sid:1000010; rev:1;)
