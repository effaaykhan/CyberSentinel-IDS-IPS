[Unit]
Description=CyberSentinel-IPS intrusion detection sensor
Documentation=https://github.com/cybersentinel/cybersentinel-IPS
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/cybersentinel run --config /etc/cybersentinel/config.yaml
Restart=on-failure
RestartSec=5s

# --- Least privilege (guide §6) --------------------------------------------
# Phase 0 needs no elevated privileges at all. From Phase 1, packet capture
# needs CAP_NET_RAW and CAP_NET_ADMIN to open the capture socket; the sensor
# opens it and then drops privileges, so the capabilities are granted as a
# bounding set rather than by running as root.
# DynamicUser lets systemd allocate and own the service account, so the package
# needs no useradd in a maintainer script and leaves no stale account behind on
# removal.
#
# CAP_DAC_READ_SEARCH is different from the two above: the network path drops
# its capabilities once the handle is open, but host monitoring goes on reading
# and hashing files it does not own for as long as it runs. A baseline that
# cannot read /etc/shadow is a baseline that silently omits the file most worth
# watching. It is ambient as well as bounded because the sensor execs one child
# — journalctl — which needs it to read /var/log/journal.
#
# Deliberately NOT here: CAP_SYS_PTRACE. It would let the sensor attribute a
# listening socket to another user's process, and it would also let it ptrace
# anything on the box. The socket is reported either way; the owner shows as
# "unknown". See §8 of CLAUDE.md for the full set.
DynamicUser=yes
AmbientCapabilities=CAP_NET_RAW CAP_NET_ADMIN CAP_DAC_READ_SEARCH
CapabilityBoundingSet=CAP_NET_RAW CAP_NET_ADMIN CAP_DAC_READ_SEARCH
NoNewPrivileges=yes

# --- Self-protection (guide §6) --------------------------------------------
# The sensor is a target: an attacker who can rewrite its rules or delete its
# event log has blinded it. Everything is read-only except the two directories
# it owns.
ProtectSystem=strict
# Host monitoring reads /var/log and /etc; ProtectSystem=strict keeps them
# read-only rather than hidden, which is exactly what FIM wants.
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectControlGroups=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
# systemd creates, owns, and permissions these two; they are the only writable
# paths the sensor has.
StateDirectory=cybersentinel
LogsDirectory=cybersentinel

# Captured traffic and host events are PII (guide §6): keep the event log
# readable only by the sensor and the administrators who need it.
UMask=0027

[Install]
WantedBy=multi-user.target
